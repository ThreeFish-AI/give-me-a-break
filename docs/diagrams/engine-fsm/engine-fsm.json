  "cards": [
    {
      "dot": "cyan",
      "title": "谓词优先级（evaluate 纯函数）",
      "items": [
        "短路序：offDuty 压过一切 → idle → 会议 → 阈值 → working",
        "触发休息不变量：workAccum ≥ workInterval 且无活跃会议",
        "零时间依赖：全部时间经注入 Clock 进入快照，可虚拟时钟单测"
      ]
    },
    {
      "dot": "amber",
      "title": "中断与恢复",
      "items": [
        "会议计为工作时间，累加器在 IN_MEETING 续推",
        "AFK / 睡眠期间累加器冻结，唤醒对账 lastTickAt 不回灌",
        "advance 每 tick 限幅 ≤ 60s 防异常 tick"
      ]
    },
    {
      "dot": "rose",
      "title": "abort-and-reset（虚线边）",
      "items": [
        "休息被会议或窗口结束打断即整体复位本轮休息",
        "复位不残留：不保留部分休息时长，下轮从零起算"
      ]
    }
  ]
