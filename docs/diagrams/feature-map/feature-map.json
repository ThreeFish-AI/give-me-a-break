  "cards": [
    {
      "dot": "cyan",
      "title": "软强制哲学",
      "items": [
        "摩擦而非硬锁：Esc 双击、看门狗、kill 始终可终止",
        "键盘守护白名单仅放行裸 Esc / Return，媒体键不受影响"
      ]
    },
    {
      "dot": "emerald",
      "title": "记录的循证",
      "items": [
        "工作日志 = 转换边界的认知闭合（Leroy 注意力残留 + 插值日记）",
        "字段可选、回车即提交、到点自动放行，永不阻塞休息"
      ]
    },
    {
      "dot": "amber",
      "title": "正交域",
      "items": [
        "电源断言与子进程托管由 AppRoot 装配，引擎不消费其配置",
        "子进程崩溃 / 退出不影响节律；意外退出不自动重启（防风暴）"
      ]
    }
